# Server
PORT=3000
NODE_ENV=development

# Google Gemini API (server-side)
GEMINI_API_KEY=

# Admin Passcode & Signed HttpOnly Cookie Secret (optional alongside Google Admin Sign-In)
QEBULFIT_ADMIN_PASSCODE=
SESSION_SECRET=

# PDF Storage (optional S3-compatible bucket; falls back to local disk when omitted)
STORAGE_DIR=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
